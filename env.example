# Template for .env — copy to .env at repo root and fill in. (Named env.example
# without the leading dot so tooling that guards .env* files doesn't block it.)

# --- database ---
MONGO_URI=mongodb://mongo:27017
DB_NAME=news_app

# --- auth ---
PW_HASH=            # bcrypt hash; generate with: cd backend && uv run python -m app.hash_pw
JWT_SECRET=         # long random string
SECURE_COOKIES=true # true behind HTTPS; false for local HTTP dev

# --- LLM / embeddings ---
ANTHROPIC_API_KEY=
VOYAGE_API_KEY=

# --- telegram (user account via Telethon) ---
TG_API_ID=
TG_API_HASH=
TG_SESSION=         # StringSession; mint once with: cd backend && uv run python -m app.tg_session
